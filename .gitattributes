# Keep the working tree LF on every platform. Windows checkouts default to
# core.autocrlf=true, which would rewrite text files to CRLF — including the
# assets embedded with go:embed (the agent skill, the JSON schemas, the config
# template), shipping CRLF payloads inside the binary.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.exe binary
